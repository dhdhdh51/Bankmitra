<?xml version="1.0" encoding="utf-8"?>
<!-- Camera captures are written into the app's own cache/files directories and
     shared with the camera app through the FileProvider declared in the
     manifest. Nothing is written to shared external storage. -->
<paths>
    <cache-path name="lrms_cache" path="." />
    <files-path name="lrms_files" path="." />

    <!-- MUST match PhotoStore.CAPTURE_DIR. This said "Pictures" while
         PhotoStore wrote into "captures", so FileProvider.getUriForFile()
         threw IllegalArgumentException for every capture and the app reported
         "the photo could not be saved" as if the device were out of space.
         path="." covers the whole app-private external files dir, so renaming
         the capture folder later cannot silently break the camera again. -->
    <external-files-path name="lrms_photos" path="." />

    <external-cache-path name="lrms_ext_cache" path="." />
</paths>
