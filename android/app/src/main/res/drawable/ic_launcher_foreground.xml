<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon FOREGROUND layer.

  Adaptive icons are 108x108dp with only the central 72x72dp guaranteed to be
  visible (the launcher may mask or parallax the rest). The logo artwork is
  authored in a 512x512 space, so it is wrapped in a group that scales it by
  0.128 (512 * 0.128 = 65.5dp, comfortably inside the 72dp safe zone) and
  translates it to the centre: (108 - 65.5) / 2 = 21.25.

  The dark-green shield gradient is dropped here because the BACKGROUND layer
  (@color/ic_launcher_background) is already that colour - keeping both would
  make the icon read as a flat green blob at small sizes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.128"
        android:scaleY="0.128"
        android:translateX="21.25"
        android:translateY="21.25">

        <!-- shield body, lightened so it separates from the dark background -->
        <path
            android:fillColor="#12775C"
            android:pathData="M256,26L74,92v168c0,96 74,175 182,226 108,-51 182,-130 182,-226V92L256,26z" />

        <!-- inner bevel -->
        <path
            android:strokeColor="#7CE9BD"
            android:strokeAlpha="0.5"
            android:strokeWidth="12"
            android:fillColor="#00000000"
            android:pathData="M256,62L108,116v144c0,80 61,147 148,191 87,-44 148,-111 148,-191V116L256,62z" />

        <!-- rupee mark -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M187,136h110a11,11 0 0 1 0,22H187a11,11 0 0 1 0,-22z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M187,182h110a11,11 0 0 1 0,22H187a11,11 0 0 1 0,-22z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M198,136h48c34,0 60,22 60,52s-26,52 -60,52h-18l86,92h-46l-92,-100v-24h66c14,0 24,-8 24,-20s-10,-20 -24,-20h-44v-32z" />

        <!-- rising recovery arrow -->
        <path
            android:fillColor="#7CE9BD"
            android:pathData="M150,386l58,-58 40,40 74,-74h-38v-34h96v96h-34v-38l-98,98 -40,-40 -38,38z" />
    </group>
</vector>
