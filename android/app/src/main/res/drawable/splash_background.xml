<?xml version="1.0" encoding="utf-8"?>
<!-- Brand-coloured splash with the logo centred. Used as windowBackground so it
     is drawn by the system before any of our code runs. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_green_dark" />
    <item android:gravity="center">
        <bitmap android:src="@mipmap/ic_launcher" android:gravity="center" />
    </item>
</layer-list>
