# =====================================================================
# LRMS - Apache / LiteSpeed configuration for cPanel shared hosting
# ---------------------------------------------------------------------
# This file belongs in the SAME folder as index.php.
# Tested against Apache 2.4 and LiteSpeed (which reads .htaccess natively).
# =====================================================================

# ---------------------------------------------------------------------
# 1. Pretty URLs -> front controller
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # If LRMS is installed in a subfolder, RewriteBase usually still works
    # without editing. Uncomment and set it only if you get 404s:
    # RewriteBase /lrms/

    # Never rewrite real files or directories (assets, uploads, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # The API has its own front controller.
    RewriteRule ^api/v1(/.*)?$ api/v1/index.php?_route=$1 [QSA,L]

    # Everything else goes to the admin panel front controller.
    RewriteRule ^(.*)$ index.php?_route=$1 [QSA,L]
</IfModule>

# Some shared hosts strip the Authorization header before PHP sees it.
# This puts it back so the Android app's Bearer token works.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# ---------------------------------------------------------------------
# 2. Block access to everything that is not meant to be public
# ---------------------------------------------------------------------
# Directories containing code, secrets and logs. Requests to these must 403
# even if mod_rewrite is unavailable.
RedirectMatch 403 ^/?(app|config|lib|cron|storage)(/|$)
RedirectMatch 403 ^.*/(app|config|lib|cron|storage)/.*$

<FilesMatch "^(config\.php|config\.sample\.php|composer\.(json|lock)|\.env.*|.*\.sql|.*\.log|.*\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Hidden files (.git, .htpasswd, editor backups)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------
# 3. Uploads must be served as inert files, never executed
# ---------------------------------------------------------------------
# A second .htaccess also lives inside uploads/ - both are intentional.
<IfModule mod_rewrite.c>
    RewriteRule ^uploads/.*\.(php|phtml|php3|php4|php5|php7|phps|pl|py|cgi|sh|htaccess)$ - [F,L]
</IfModule>

# ---------------------------------------------------------------------
# 4. Force HTTPS (enable after installing the free AutoSSL certificate
#    from cPanel > SSL/TLS Status)
# ---------------------------------------------------------------------
# <IfModule mod_rewrite.c>
#     RewriteCond %{HTTPS} off
#     RewriteCond %{HTTP:X-Forwarded-Proto} !https
#     RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# </IfModule>

# ---------------------------------------------------------------------
# 5. Security headers
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
    # Enable once you are on HTTPS everywhere:
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # The panel loads Bootstrap, Bootstrap Icons and Chart.js from jsDelivr and
    # the Google Maps JS API. Adjust if you self-host those assets.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net data:; img-src 'self' data: blob: https://*.googleapis.com https://*.gstatic.com; connect-src 'self' https://maps.googleapis.com; frame-ancestors 'self'"
    Header unset X-Powered-By
</IfModule>

# ---------------------------------------------------------------------
# 6. Compression and caching for static assets
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 7 days"
    ExpiresByType application/javascript  "access plus 7 days"
    ExpiresByType image/png               "access plus 30 days"
    ExpiresByType image/jpeg              "access plus 30 days"
    ExpiresByType image/svg+xml           "access plus 30 days"
    ExpiresByType font/woff2              "access plus 30 days"
</IfModule>

# ---------------------------------------------------------------------
# 7. PHP settings
# ---------------------------------------------------------------------
# NOTE: on most cPanel hosts PHP runs as CGI/FPM and php_value here is IGNORED
# (it may even cause a 500 error). Prefer cPanel > "MultiPHP INI Editor" or a
# .user.ini file. The .user.ini shipped alongside this file does the same job.
<IfModule mod_php.c>
    php_value upload_max_filesize 24M
    php_value post_max_size 32M
    php_value max_execution_time 300
    php_value memory_limit 256M
</IfModule>

# ---------------------------------------------------------------------
# 8. Default document
# ---------------------------------------------------------------------
DirectoryIndex index.php
Options -Indexes
